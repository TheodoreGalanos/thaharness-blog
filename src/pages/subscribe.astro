<!-- ABOUTME: A direct newsletter signup with the same form and error handling used after articles. -->
<!-- ABOUTME: Describes the publication cadence without decorative status or build claims. -->
---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head
		><BaseHead
			title={`Subscribe | ${SITE_TITLE}`}
			description="New essays on harness engineering, agent evaluation and AI in AEC, delivered when they publish."
		/></head
	>
	<body
		><Header /><main id="main-content" class="subscribe-page page-shell">
			<h1>Follow the work.</h1>
			<p class="subscribe-deck">
				Essays on building reliable AI agents, evaluating real engineering work, and learning from
				what fails.
			</p>
			<SubscribeForm
				variant="inline"
				title="Get new essays by email"
				description="New writing when it publishes. No daily digest or marketing. Unsubscribe at any time."
				inputId="subscribe-page-email"
			/>
			<p class="feed-alternative">
				Prefer a feed reader? <a href="/rss.xml">Follow the RSS feed</a>.
			</p>
		</main><Footer /><Analytics /><SpeedInsights /></body>
</html>
<style>
	.subscribe-page {
		max-width: 44rem;
		padding-top: 3rem;
	}
	h1 {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
	}
	.subscribe-deck {
		color: var(--color-text-secondary);
		margin: 1.25rem 0 2.5rem;
	}
	.feed-alternative {
		margin-top: 2rem;
		font-size: 1rem;
	}
</style>
