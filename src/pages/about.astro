<!-- ABOUTME: About page introducing Theodoros Galanos and the work behind The Harness. -->
<!-- ABOUTME: Editorial treatment — Fraunces display headline, mono kicker, serif body at reading scale. -->
---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="Theodoros Galanos writes about harness engineering, agentic AI evaluation, and the practical work of making AI agents reliable in AEC and domain-specific engineering."
		/>
	</head>
	<body class="bg-[var(--color-bg)]">
		<Header />
		<main id="main-content" class="px-6 py-16 md:py-24">
			<article class="mx-auto max-w-[42rem]">
				<header class="about-header">
					<span class="about-kicker">About</span>
					<h1 class="about-headline">Theodoros Galanos</h1>
					<p class="about-deck">
						A working notebook on harness engineering, agentic systems, and the work of making AI
						useful in real engineering practice.
					</p>
				</header>

				<div class="about-body">
					<p>
						I work at the intersection of AI, design and engineering. The Harness is where I publish
						what I learn from building agentic systems and testing them against real engineering
						work.
					</p>
					<p>
						My central question is what makes an agent's work trustworthy. That includes the tools
						it can use, the evidence it must produce, the checks around its outputs, and the
						decisions that remain with people.
					</p>
					<h2>Work you can inspect</h2>
					<ul>
						<li>
							<a href="/blog/benchmarking-agents-on-real-engineering-work/"
								>AEC-Bench: evaluating engineering agents.</a
							> Experiments with HVAC tasks, model comparisons, and the effect of removing harness guidance.
						</li>
						<li>
							<a href="/blog/fluent-but-unsafe/">Auditing the benchmark itself.</a> What looked like finished
							work and strong scores did not always survive engineering review. The <a
								href="/runs/road-low-point-review/">published road-corridor run</a
							> includes the source record and verifier receipt.
						</li>
						<li>
							<a href="/blog/recursive-by-design/">Building recursive agents.</a> The design and practical
							limits of Lambda-RLM on engineering tasks.
						</li>
					</ul>
					<p>
						I also write about <a href="/blog/broad-creation-narrow-authority/"
							>organisational authority</a
						> and <a href="/blog/the-distance-to-the-edge/">learning through repeated experiments</a
						>. The technical and organisational conditions matter together.
					</p>
					<p>
						For a broader view of my work, visit <a
							href="https://www.linkedin.com/in/theodorosgalanos/">LinkedIn</a
						> or <a href="https://github.com/TheodoreGalanos">GitHub</a>. To follow new writing, <a
							href="/subscribe/">subscribe by email</a
						> or use the <a href="/rss.xml">RSS feed</a>.
					</p>
				</div>
			</article>
		</main>
		<Footer />
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style>
	.about-header {
		margin-bottom: 3rem;
	}

	.about-kicker {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
		margin-bottom: 1.25rem;
	}

	.about-headline {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.015em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.about-deck {
		font-family: var(--font-body);
		font-size: 1.25rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 1.25rem 0 0;
		max-width: 36rem;
	}

	.about-body {
		font-family: var(--font-body);
		font-size: 1.1875rem;
		line-height: 1.8;
		color: var(--color-text-primary);
	}

	.about-body p {
		margin: 0 0 1.5em;
	}

	.about-body p:last-child {
		margin-bottom: 0;
	}

	.about-body a {
		color: var(--color-text-primary);
		text-decoration: none;
		background-image: linear-gradient(var(--color-text-tertiary), var(--color-text-tertiary));
		background-size: 100% 1px;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition:
			color 0.25s var(--ease-standard),
			background-image 0.25s var(--ease-standard);
	}

	.about-body a:hover {
		color: var(--color-accent);
		background-image: linear-gradient(var(--color-accent), var(--color-accent));
	}

	@media (max-width: 768px) {
		.about-body {
			font-size: 1.0625rem;
			line-height: 1.75;
		}
	}
</style>

<style>
	.about-body h2 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		margin: 2rem 0 1rem;
	}
	.about-body li {
		margin-bottom: 1rem;
	}
</style>
