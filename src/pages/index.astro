<!-- ABOUTME: Introduces the publication through its latest essay and three curated reading paths. -->
<!-- ABOUTME: Uses a compact editorial layout so readers reach the writing immediately. -->
---
import { getCollection } from 'astro:content';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/landing.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlueprintBg from '../components/landing/BlueprintBg.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedBlogPosts } from '../utils/blog';
import { topics } from '../data/topics';
const posts = getPublishedBlogPosts(await getCollection('blog'));
const [latest, ...recent] = posts;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head
		><BaseHead
			title={`${SITE_TITLE} — Harness Engineering & Agentic AI for AEC`}
			description={SITE_DESCRIPTION}
		/></head
	>
	<body>
		<Header />
		<main id="main-content" class="home page-shell">
			<BlueprintBg class="home-intro">
				<p class="home-author">A working notebook by <a href="/about/">Theodoros Galanos</a></p>
				<h1>AI agents for real engineering work.</h1>
				<p class="home-deck">
					How to build and evaluate them. What fails in practice. And what it takes to make the
					results trustworthy.
				</p>
			</BlueprintBg>
			{
				latest && (
					<section class="latest" aria-labelledby="latest-label">
						<div class="section-label">
							<>
								<h2 id="latest-label">Latest essay</h2>
								<FormattedDate date={latest.data.pubDate} />
							</>
						</div>
						<a class="latest-link" href={`/blog/${latest.id}/`}>
							<>
								<h3>{latest.data.title}</h3>
								<p>{latest.data.description}</p>
								<span class="read-link">Read the essay →</span>
							</>
						</a>
					</section>
				)
			}
			<section class="reading-paths" aria-labelledby="paths-label">
				<h2 id="paths-label">Where to start</h2>
				<div class="path-grid">
					{
						topics.map((topic) => (
							<a href={`/tags/${topic.tag}/`}>
								<>
									<h3>{topic.task}</h3>
									<p>{topic.description}</p>
									<span class="read-link">{topic.title} →</span>
								</>
							</a>
						))
					}
				</div>
			</section>
			<section class="recent" aria-labelledby="recent-label">
				<div class="section-label">
					<h2 id="recent-label">Recent writing</h2><a href="/blog/">All {posts.length} essays →</a>
				</div>
				<ul>
					{
						recent.slice(0, 5).map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<>
										<FormattedDate date={post.data.pubDate} />
										<div>
											<>
												<h3>{post.data.title}</h3>
												<p>{post.data.description}</p>
											</>
										</div>
									</>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<aside class="home-follow">
				<h2>Follow the work</h2><p>New essays by email when they publish.</p><a
					class="cmd-btn cmd-btn-primary"
					href="/subscribe/">Subscribe by email</a
				><a href="/rss.xml">RSS feed</a>
			</aside>
		</main>
		<Footer /><Analytics /><SpeedInsights />
	</body>
</html>
<style>
	.home {
		max-width: 68rem;
	}
	.home :global(.home-intro) {
		padding: 3rem 0 2rem;
	}
	.home-author {
		color: var(--color-text-secondary);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		margin: 0 0 1rem;
	}
	h1 {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		max-width: 46rem;
		line-height: 1.1;
	}
	.home-deck {
		max-width: 40rem;
		color: var(--color-text-secondary);
		margin: 1rem 0 0;
	}
	.latest {
		padding: 1.5rem 0 2.5rem;
		border-top: 1px solid var(--color-accent-secondary);
	}
	.section-label {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
	}
	.section-label h2 {
		font: inherit;
		color: inherit;
		margin: 0;
	}
	.latest-link {
		display: block;
		padding-top: 1rem;
		max-width: 48rem;
		color: var(--color-text-primary);
	}
	.latest h3 {
		font-family: var(--font-display);
		font-size: clamp(1.875rem, 4vw, 2.75rem);
	}
	.latest p {
		margin: 0.75rem 0;
		color: var(--color-text-secondary);
	}
	.read-link {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-accent);
	}
	.reading-paths,
	.recent {
		padding: 2rem 0;
		border-top: 1px solid var(--color-border);
	}
	.reading-paths > h2,
	.home-follow h2 {
		font-family: var(--font-display);
		font-size: 1.75rem;
		margin-bottom: 1.25rem;
	}
	.path-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}
	.path-grid a {
		color: var(--color-text-primary);
	}
	.path-grid h3 {
		font-family: var(--font-display);
		font-size: 1.375rem;
	}
	.path-grid p {
		font-size: 1.0625rem;
		color: var(--color-text-secondary);
		margin: 0.75rem 0;
	}
	.recent ul {
		list-style: none;
		padding: 0;
		margin-top: 1rem;
	}
	.recent li {
		border-top: 1px solid var(--color-border);
	}
	.recent li a {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1.5rem;
		padding: 1.5rem 0;
		color: var(--color-text-primary);
	}
	.recent :global(time) {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
	}
	.recent h3 {
		font-family: var(--font-display);
		font-size: 1.5rem;
	}
	.recent p {
		margin: 0.5rem 0 0;
		color: var(--color-text-secondary);
		font-size: 1.0625rem;
	}
	.home-follow {
		padding: 2rem 0;
		border-top: 1px solid var(--color-border);
	}
	.home-follow p {
		margin: 0 0 1rem;
	}
	.home-follow a {
		margin-right: 1.5rem;
	}
	@media (max-width: 639px) {
		.home :global(.home-intro) {
			padding-top: 2rem;
		}
		.path-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
		.recent li a {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
