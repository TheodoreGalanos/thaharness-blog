<!-- ABOUTME: Reusable tag pill component that links to a tag-filtered listing page. -->
<!-- ABOUTME: Displays a small monospace pill with surface background and border styling. -->
---
interface Props {
	tag: string;
}

const { tag } = Astro.props;
---

<a
	href={`/tags/${tag}/`}
	class="inline-flex min-h-11 shrink-0 items-center justify-start whitespace-nowrap text-left leading-none font-heading text-[0.6875rem] uppercase tracking-[0.05em] text-[var(--color-text-secondary)] bg-[var(--color-surface)] border border-[var(--color-border)] rounded px-2.5 py-1 no-underline hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors duration-250 sm:min-h-0"
>
	{tag}
</a>
