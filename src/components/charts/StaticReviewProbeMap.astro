<!-- ABOUTME: Maps all twenty-one static-review model runs on a shared reward scale. -->
<!-- ABOUTME: Separates cross-task coverage from repeated reliability runs and labels documented failures. -->
---
import type {
	StaticReviewProbeMapData,
	StaticReviewProbePoint,
} from '../../data/fluent-but-unsafe-figures';

interface Props {
	title?: string;
	data: StaticReviewProbeMapData;
	caption?: string;
}

const { title, data, caption } = Astro.props;
const [minimum, maximum] = data.domain;

function pointPercent(reward: number): number {
	const bounded = Math.min(Math.max(reward, minimum), maximum);
	return ((bounded - minimum) / (maximum - minimum)) * 100;
}

function boundedPointLeft(reward: number): string {
	return `clamp(0.45rem, ${pointPercent(reward)}%, calc(100% - 0.45rem))`;
}

function pointLaneTop(points: StaticReviewProbePoint[], pointIndex: number): string {
	if (points.length < 3) return '50%';

	const horizontalOrder = points
		.map((point, index) => ({ reward: point.reward, index }))
		.sort((left, right) => left.reward - right.reward || left.index - right.index);
	const horizontalRank = horizontalOrder.findIndex(({ index }) => index === pointIndex);

	return horizontalRank % 2 === 0 ? '34%' : '66%';
}
---

<figure class="srp" data-static-review-probe-map>
	{title && <div class="srp-title">{title}</div>}

	<div class="srp-legend" aria-hidden="true">
		<span><i class="srp-key srp-key-small"></i>small model</span>
		<span><i class="srp-key srp-key-strong"></i>strong model</span>
		<span>horizontal position = score</span>
	</div>

	<div class="srp-data">
		<table>
			<caption>Single-pass model runs by section, task, model, task version, score, and recorded finding</caption>
			<thead>
				<tr>
					<th scope="col">Section</th>
					<th scope="col">Task</th>
					<th scope="col">Model</th>
					<th scope="col">Task version</th>
					<th scope="col">Score</th>
					<th scope="col">Recorded finding</th>
				</tr>
			</thead>
			<tbody>
				{data.sections.map((section) => section.rows.map((row) => row.points.map((point) => (
					<tr>
						<td>{section.label}</td>
						<th scope="row">{row.label}</th>
						<td>{point.model === 'small' ? 'Small model' : 'Strong model'}</td>
						<td>{point.condition}</td>
						<td>{point.reward.toFixed(2)}</td>
						<td>{point.finding}</td>
					</tr>
				))))}
			</tbody>
		</table>
	</div>

	<div class="srp-plot" aria-hidden="true">
		{data.sections.map((section) => (
			<section class="srp-section">
				<header class="srp-section-header">
					<strong>{section.label}</strong>
					<span>{section.summary}</span>
				</header>

				<div class="srp-axis-row">
					<div></div>
					<div class="srp-axis">
						{data.ticks.map((tick, index) => (
							<span
								data-last={index === data.ticks.length - 1 ? 'true' : undefined}
								style={`left: ${pointPercent(tick)}%;`}
							>
								{tick.toFixed(1)}
							</span>
						))}
					</div>
				</div>

				<div class="srp-rows">
					{section.rows.map((row) => (
						<div class="srp-row">
							<div class="srp-row-label">
								<span class="srp-label-full">{row.label}</span>
								<span class="srp-label-compact">{row.compactLabel}</span>
							</div>
							<div class="srp-track">
								{data.ticks.map((tick, tickIndex) => (
									<i
										class="srp-gridline"
										data-last={tickIndex === data.ticks.length - 1 ? 'true' : undefined}
										style={`left: ${pointPercent(tick)}%;`}
									></i>
								))}
								{row.points.map((point, pointIndex) => (
									<>
										<span
											class:list={[
												'srp-mark',
												`srp-mark-${point.model}`,
												point.emphasis && `srp-mark-${point.emphasis}`,
											]}
											style={`left: ${boundedPointLeft(point.reward)}; top: ${pointLaneTop(row.points, pointIndex)};`}
										>
											<i></i>
										</span>
										{point.annotation && (
											<span
												class:list={['srp-annotation', `srp-annotation-${point.annotationSide ?? 'right'}`]}
												style={`left: ${boundedPointLeft(point.reward)}; top: ${pointLaneTop(row.points, pointIndex)};`}
											>
												{point.annotation}
											</span>
										)}
									</>
								))}
							</div>
						</div>
					))}
				</div>

				{section.footer && (
					<div class="srp-footer">
						{section.footer.map((item) => <span>{item}</span>)}
					</div>
				)}
			</section>
		))}
	</div>

	{caption && <figcaption class="srp-caption">{caption}</figcaption>}
</figure>

<style>
	.srp {
		--srp-small: var(--color-accent-secondary);
		--srp-strong: var(--color-accent);
		--srp-signal: var(--color-text-primary);
		--srp-phantom: #d87b55;

		margin: 3rem 0;
		font-family: var(--font-body);
		color: var(--color-text-primary);
		container-type: inline-size;
	}

	.srp-title {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.srp-data {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.srp-data table {
		width: max-content;
	}

	.srp-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin-bottom: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-text-tertiary);
	}

	.srp-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.srp-key {
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		background: var(--srp-small);
		border: 1px solid var(--color-bg);
		border-radius: 50%;
	}

	.srp-key-strong {
		border-radius: 1px;
		background: var(--srp-strong);
		transform: rotate(45deg);
	}

	.srp-section + .srp-section {
		margin-top: 2rem;
	}

	.srp-section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--color-border);
	}

	.srp-section-header strong {
		font-size: 0.875rem;
		font-weight: 500;
	}

	.srp-section-header span,
	.srp-footer {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-text-tertiary);
	}

	.srp-axis-row,
	.srp-row {
		display: grid;
		grid-template-columns: minmax(7rem, 8rem) minmax(0, 1fr);
		column-gap: 0.75rem;
	}

	.srp-axis {
		position: relative;
		height: 1.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-text-tertiary);
	}

	.srp-axis span {
		position: absolute;
		top: 0.25rem;
		transform: translateX(-50%);
	}

	.srp-axis span[data-last='true'] {
		transform: translateX(-100%);
	}

	.srp-row {
		align-items: center;
		min-height: 3rem;
	}

	.srp-row-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-secondary);
		white-space: nowrap;
	}

	.srp-label-compact {
		display: none;
	}

	.srp-track {
		position: relative;
		height: 3rem;
		min-width: 0;
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 65%, transparent);
	}

	.srp-gridline {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--color-border);
		opacity: 0.62;
	}

	.srp-gridline[data-last='true'] {
		transform: translateX(-1px);
	}

	.srp-mark {
		position: absolute;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 0.7rem;
		height: 0.7rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
	}

	.srp-mark > i {
		display: block;
		width: 0.62rem;
		height: 0.62rem;
		border: 1px solid var(--color-bg);
		border-radius: 50%;
		background: var(--srp-small);
	}

	.srp-mark-strong > i {
		border-radius: 1px;
		background: var(--srp-strong);
		transform: rotate(45deg);
	}

	.srp-mark-signal {
		box-shadow: 0 0 0 1px var(--color-bg), 0 0 0 2px var(--srp-signal);
	}

	.srp-mark-phantom {
		box-shadow: 0 0 0 1px var(--color-bg), 0 0 0 2px var(--srp-phantom);
	}

	.srp-annotation {
		position: absolute;
		z-index: 3;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
		color: var(--color-text-primary);
	}

	.srp-annotation-right {
		transform: translate(0.65rem, -50%);
	}

	.srp-annotation-left {
		transform: translate(calc(-100% - 0.65rem), -50%);
	}

	.srp-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		padding-left: 8.75rem;
		margin-top: 0.5rem;
	}

	.srp-caption {
		margin: 1rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-text-tertiary);
	}

	@container (max-width: 480px) {
		.srp-section-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.1rem;
		}

		.srp-axis-row,
		.srp-row {
			grid-template-columns: minmax(4.75rem, 5.4rem) minmax(0, 1fr);
			column-gap: 0.5rem;
		}

		.srp-label-full {
			display: none;
		}

		.srp-label-compact {
			display: inline;
		}

		.srp-row-label {
			font-size: 0.6875rem;
		}

		.srp-annotation {
			font-size: 0.625rem;
		}

		.srp-annotation-right {
			transform: translate(0.45rem, -50%);
		}

		.srp-annotation-left {
			transform: translate(calc(-100% - 0.45rem), -50%);
		}

		.srp-footer {
			flex-direction: column;
			padding-left: 5.9rem;
		}
	}
</style>
