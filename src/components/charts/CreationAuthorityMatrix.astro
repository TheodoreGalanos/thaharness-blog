<!-- ABOUTME: Compares software creation method with the authority an artefact holds. -->
<!-- ABOUTME: Shows that consequential risk cuts across both human and AI-created work. -->
---
import { creationAuthorityFigure } from '../../data/broad-creation-narrow-authority-figures';

const titleId = 'creation-authority-title';
const descriptionId = 'creation-authority-description';
---

<figure class="cam" aria-labelledby={titleId} aria-describedby={descriptionId}>
	<header class="cam-header">
		<span class="cam-kicker">Risk map</span>
		<span class="cam-thesis">Creation method × authority</span>
	</header>

	<div class="cam-title" id={titleId}>{creationAuthorityFigure.title}</div>
	<p class="visually-hidden" id={descriptionId}>{creationAuthorityFigure.description}</p>

	<div class="cam-canvas" aria-hidden="true">
		<div class="cam-y-axis">
			<span>Authority it holds</span>
		</div>

		<div class="cam-chart">
			<div class="cam-plot">
				<span class="cam-pole cam-pole-high">Acts on the world</span>
				<span class="cam-pole cam-pole-low">Isolated · reversible</span>
				<span class="cam-method-boundary">The boundary “vibe coding” polices</span>
				<span class="cam-authority-boundary">The boundary that matters</span>

				{creationAuthorityFigure.examples.map((example) => (
					<div
						class:list={[
							'cam-example',
							`is-${example.method}`,
							`is-${example.authority}`,
						]}
					>
						<i class="cam-point"></i>
						<strong>{example.label}</strong>
						<span>{example.detail}</span>
					</div>
				))}
			</div>

			<div class="cam-x-axis">
				<span>Human-written</span>
				<strong>How it was created</strong>
				<span>AI-generated</span>
			</div>
		</div>
	</div>

	<figcaption class="cam-caption">{creationAuthorityFigure.caption}</figcaption>
</figure>

<style>
	.cam {
		--cam-accent: var(--color-accent);
		--cam-secondary: var(--color-accent-secondary);
		--cam-line: color-mix(in srgb, var(--color-text-tertiary) 68%, transparent);
		--cam-soft-line: color-mix(in srgb, var(--color-border) 82%, transparent);

		margin: 3.25rem 0 4rem;
		color: var(--color-text-primary);
		font-family: var(--font-body);
		text-align: left;
		container-type: inline-size;
	}

	.cam-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.cam-kicker,
	.cam-thesis,
	.cam-y-axis,
	.cam-pole,
	.cam-method-boundary,
	.cam-authority-boundary,
	.cam-example span,
	.cam-x-axis,
	.cam-caption {
		font-family: var(--font-mono);
	}

	.cam-kicker {
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cam-accent);
	}

	.cam-thesis {
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.cam-title {
		margin: 0.9rem 0 1.35rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.cam-canvas {
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr);
		gap: 0.75rem;
	}

	.cam-y-axis {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.5625rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.cam-y-axis::before {
		content: '';
		position: absolute;
		top: 0.2rem;
		left: 50%;
		bottom: 2.2rem;
		border-left: 1px solid var(--cam-line);
	}

	.cam-y-axis::after {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 0;
		height: 0;
		border-right: 4px solid transparent;
		border-bottom: 7px solid var(--cam-line);
		border-left: 4px solid transparent;
		transform: translateX(-50%);
	}

	.cam-y-axis span {
		position: relative;
		z-index: 1;
		padding: 0.45rem 0;
		background: var(--color-bg);
		white-space: nowrap;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
	}

	.cam-chart {
		min-width: 0;
	}

	.cam-plot {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		min-height: 22rem;
		border: 1px solid var(--cam-soft-line);
		border-radius: 5px;
		background:
			linear-gradient(
				to bottom,
				color-mix(in srgb, var(--cam-accent) 5%, transparent) 0 50%,
				color-mix(in srgb, var(--cam-secondary) 5%, transparent) 50% 100%
			),
			linear-gradient(var(--color-bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-bg-grid) 1px, transparent 1px),
			color-mix(in srgb, var(--color-surface) 74%, transparent);
		background-size: auto, 2rem 2rem, 2rem 2rem, auto;
		overflow: hidden;
	}

	.cam-plot::before {
		content: '';
		position: absolute;
		z-index: 3;
		top: 50%;
		right: 0;
		left: 0;
		height: 2px;
		background: var(--cam-accent);
		box-shadow: 0 0 16px color-mix(in srgb, var(--cam-accent) 24%, transparent);
	}

	.cam-plot::after {
		content: '';
		position: absolute;
		z-index: 1;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		background: repeating-linear-gradient(
			to bottom,
			var(--cam-line) 0 5px,
			transparent 5px 10px
		);
	}

	.cam-pole,
	.cam-method-boundary,
	.cam-authority-boundary {
		position: absolute;
		z-index: 4;
		font-size: 0.5625rem;
		line-height: 1.4;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.cam-pole {
		left: 0.75rem;
		color: var(--color-text-tertiary);
	}

	.cam-pole-high {
		top: 0.65rem;
	}

	.cam-pole-low {
		bottom: 0.65rem;
	}

	.cam-method-boundary {
		top: 0.65rem;
		left: 50%;
		max-width: 9rem;
		padding: 0.2rem 0.4rem;
		background: color-mix(in srgb, var(--color-bg) 88%, transparent);
		text-align: center;
		color: var(--color-text-tertiary);
		transform: translateX(-50%);
	}

	.cam-authority-boundary {
		top: 50%;
		right: 0.75rem;
		padding: 0.2rem 0.4rem;
		background: var(--color-bg);
		color: var(--cam-accent);
		transform: translateY(-50%);
	}

	.cam-example {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.22rem;
		min-width: 0;
		padding: 2.4rem 0.8rem 1.6rem;
		text-align: center;
	}

	.cam-example.is-human {
		grid-column: 1;
	}

	.cam-example.is-ai {
		grid-column: 2;
	}

	.cam-example.is-high {
		grid-row: 1;
	}

	.cam-example.is-low {
		grid-row: 2;
	}

	.cam-point {
		width: 0.75rem;
		height: 0.75rem;
		margin-bottom: 0.35rem;
		border: 2px solid currentColor;
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 10%, transparent);
	}

	.cam-example.is-high .cam-point {
		color: var(--cam-accent);
		background: var(--cam-accent);
	}

	.cam-example.is-low .cam-point {
		color: var(--cam-secondary);
		background: var(--cam-secondary);
	}

	.cam-example strong {
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.cam-example span {
		max-width: 11rem;
		font-size: 0.625rem;
		line-height: 1.45;
		color: var(--color-text-tertiary);
	}

	.cam-x-axis {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		gap: 0.75rem;
		margin-top: 0.7rem;
		font-size: 0.5625rem;
		line-height: 1.4;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.cam-x-axis strong {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.cam-x-axis span:last-child {
		text-align: right;
	}

	.cam-caption {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--color-text-tertiary);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@container (max-width: 34rem) {
		.cam {
			margin: 2.5rem 0 3rem;
		}

		.cam-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.45rem;
		}

		.cam-title {
			margin-bottom: 1rem;
		}

		.cam-canvas {
			grid-template-columns: 1.8rem minmax(0, 1fr);
			gap: 0.45rem;
		}

		.cam-plot {
			min-height: 19rem;
		}

		.cam-pole,
		.cam-method-boundary,
		.cam-authority-boundary {
			font-size: 0.5rem;
		}

		.cam-method-boundary {
			max-width: 7rem;
		}

		.cam-authority-boundary {
			right: 0.35rem;
			max-width: 6.5rem;
			text-align: right;
		}

		.cam-example {
			padding: 2.8rem 0.35rem 1.35rem;
		}

		.cam-example strong {
			font-size: 0.75rem;
		}

		.cam-example span {
			font-size: 0.5625rem;
		}

		.cam-x-axis {
			grid-template-columns: 1fr 1fr;
		}

		.cam-x-axis strong {
			grid-column: 1 / -1;
			grid-row: 1;
			text-align: center;
		}

		.cam-x-axis span {
			grid-row: 2;
		}
	}
</style>
