<!-- ABOUTME: Editorial checkpoint profile showing model turns across staged SSC-03 evidence. -->
<!-- ABOUTME: Plots every public trial and marks incomplete checkpoints separately from completed work. -->
---
import type {
	CheckpointKey,
	CheckpointTurnCondition,
	CheckpointTurnPoint,
} from '../../data/the-packet-starts-moving-figures';

interface Props {
	title?: string;
	subtitle?: string;
	maxTurns: number;
	checkpoints: Array<{ key: CheckpointKey; label: string }>;
	conditions: CheckpointTurnCondition[];
	caption?: string;
}

const { title, subtitle, maxTurns, checkpoints, conditions, caption } = Astro.props;

const VARIANT_LABELS: Record<CheckpointTurnPoint['variant'], string> = {
	administrative: 'No-op revision',
	major_idf: 'Major IDF',
	outlet: 'Outlet geometry',
	tailwater: 'Tailwater',
};

function pointLeft(turns: number): string {
	return `${Math.min(turns / maxTurns, 1) * 100}%`;
}

function boundedPointLeft(turns: number): string {
	return `clamp(0.45rem, ${pointLeft(turns)}, calc(100% - 0.45rem))`;
}

function pointTop(index: number): string {
	return `${18 + index * 21}%`;
}

function meanText(value: number): string {
	return Number.isInteger(value) ? value.toFixed(0) : value.toFixed(2).replace(/0$/, '');
}
---

<figure class="ctp">
	{title && (
		<div class="ctp-title">
			{title}
			{subtitle && <span class="ctp-subtitle"> · {subtitle}</span>}
		</div>
	)}

	<div class="ctp-legend" aria-hidden="true">
		{Object.entries(VARIANT_LABELS).map(([variant, label]) => (
			<span><i class={`ctp-point ctp-point-${variant}`}></i>{label}</span>
		))}
		<span><i class="ctp-point ctp-point-incomplete">×</i>incomplete</span>
	</div>

	<table class="ctp-data">
		<caption>Checkpoint turns by condition, checkpoint, public variant, and completion status</caption>
		<thead>
			<tr>
				<th scope="col">Condition</th>
				<th scope="col">Checkpoint</th>
				<th scope="col">Variant</th>
				<th scope="col">Turns</th>
				<th scope="col">Status</th>
			</tr>
		</thead>
		<tbody>
			{conditions.map((condition) => checkpoints.map((checkpoint) =>
				condition.values[checkpoint.key].map((point) => (
					<tr>
						<th scope="row">{condition.label}</th>
						<td>{checkpoint.label}</td>
						<td>{VARIANT_LABELS[point.variant]}</td>
						<td>{point.turns}</td>
						<td>{point.status === 'incomplete' ? 'Incomplete' : 'Completed'}</td>
					</tr>
				))
			))}
		</tbody>
	</table>

	<div class="ctp-header" aria-hidden="true">
		<div></div>
		{checkpoints.map((checkpoint) => (
			<div>{checkpoint.label}<span>0–{maxTurns} turns</span></div>
		))}
	</div>

	<div class="ctp-rows" aria-hidden="true">
		{conditions.map((condition) => (
			<div class="ctp-row" data-selected={condition.selected ? 'true' : 'false'}>
				<div class="ctp-row-label">
					<span>{condition.label}</span>
					{condition.selected && <small>selected</small>}
				</div>
				{checkpoints.map((checkpoint) => (
					<div class="ctp-track" data-checkpoint={checkpoint.label}>
						<div class="ctp-gridlines" aria-hidden="true"></div>
						<div
							class="ctp-mean"
							style={`left: ${pointLeft(condition.means[checkpoint.key])};`}
							aria-hidden="true"
						></div>
						<span
							class="ctp-mean-value"
							style={`left: ${pointLeft(condition.means[checkpoint.key])};`}
						>
							μ {meanText(condition.means[checkpoint.key])}
						</span>
						{condition.values[checkpoint.key].map((point, index) => (
							<span
								class:list={[
									'ctp-point',
									`ctp-point-${point.variant}`,
									point.status === 'incomplete' && 'ctp-point-incomplete',
								]}
								style={`left: ${boundedPointLeft(point.turns)}; top: ${pointTop(index)};`}
								aria-label={`${condition.label}, ${checkpoint.label}, ${VARIANT_LABELS[point.variant]}: ${point.turns} turns${point.status === 'incomplete' ? ', incomplete' : ''}`}
							>
								{point.status === 'incomplete' ? '×' : ''}
							</span>
						))}
					</div>
				))}
			</div>
		))}
	</div>

	{caption && <figcaption class="ctp-caption">{caption}</figcaption>}
</figure>

<style>
	.ctp {
		--ctp-good: #7ab5af;
		--ctp-warn: #e8a84c;
		--ctp-fail: #bf4d43;
		margin: 3rem 0;
		font-family: var(--font-body);
		color: var(--color-text-primary);
	}

	.ctp-title {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
		margin: 0 0 0.75rem;
	}

	.ctp-data {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.ctp-subtitle {
		color: var(--color-text-tertiary);
		font-weight: 400;
	}

	.ctp-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1rem;
		margin-bottom: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-text-tertiary);
	}

	.ctp-legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.ctp-legend .ctp-point {
		position: static;
		transform: none;
		flex: 0 0 auto;
	}

	.ctp-legend .ctp-point-major_idf,
	.ctp-legend .ctp-point-outlet {
		transform: rotate(45deg);
	}

	.ctp-header,
	.ctp-row {
		display: grid;
		grid-template-columns: minmax(8rem, 10rem) repeat(3, minmax(0, 1fr));
		column-gap: 1rem;
	}

	.ctp-header {
		align-items: end;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-text-secondary);
	}

	.ctp-header span {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.625rem;
		color: var(--color-text-tertiary);
	}

	.ctp-rows {
		display: flex;
		flex-direction: column;
	}

	.ctp-row {
		align-items: center;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.ctp-row-label {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-secondary);
	}

	.ctp-row[data-selected='true'] .ctp-row-label {
		color: var(--color-accent-secondary);
	}

	.ctp-row-label small {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.ctp-track {
		position: relative;
		height: 4rem;
		min-width: 0;
	}

	.ctp-gridlines {
		position: absolute;
		inset: 0;
		border-left: 1px solid var(--color-border);
		border-right: 1px solid var(--color-border);
		background: repeating-linear-gradient(
			90deg,
			transparent 0 calc(33.333% - 1px),
			var(--color-border) calc(33.333% - 1px) 33.333%
		);
		opacity: 0.7;
	}

	.ctp-mean {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--color-text-primary);
		opacity: 0.7;
		transform: translateX(-50%);
	}

	.ctp-row[data-selected='true'] .ctp-mean {
		width: 2px;
		background: var(--color-accent-secondary);
		opacity: 1;
	}

	.ctp-mean-value {
		position: absolute;
		top: -0.25rem;
		transform: translateX(-50%);
		padding: 0 0.2rem;
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-text-tertiary);
		white-space: nowrap;
	}

	.ctp-point {
		position: absolute;
		display: grid;
		place-items: center;
		width: 0.55rem;
		height: 0.55rem;
		transform: translate(-50%, -50%);
		border: 1px solid var(--color-bg);
		background: var(--ctp-good);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1;
		color: var(--ctp-fail);
	}

	.ctp-point-administrative { border-radius: 50%; }
	.ctp-point-major_idf { border-radius: 1px; transform: translate(-50%, -50%) rotate(45deg); }
	.ctp-point-outlet { border-radius: 50% 50% 0 50%; transform: translate(-50%, -50%) rotate(45deg); }
	.ctp-point-tailwater { border-radius: 50%; background: transparent; border: 2px solid var(--ctp-good); }
	.ctp-point-incomplete {
		width: 0.9rem;
		height: 0.9rem;
		border: none;
		border-radius: 0;
		background: transparent;
		transform: translate(-50%, -50%);
		font-size: 0.875rem;
	}

	.ctp-caption {
		margin: 1rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-text-tertiary);
	}

	@media (max-width: 700px) {
		.ctp-header { display: none; }

		.ctp-row {
			grid-template-columns: minmax(5.5rem, 7rem) minmax(0, 1fr);
			column-gap: 0.8rem;
			row-gap: 1.45rem;
			align-items: start;
			padding: 1.25rem 0;
		}

		.ctp-row-label {
			grid-row: 1 / span 3;
		}

		.ctp-track {
			grid-column: 2;
		}

		.ctp-track::before {
			content: attr(data-checkpoint);
			position: absolute;
			top: -1rem;
			left: 0;
			font-family: var(--font-mono);
			font-size: 0.625rem;
			color: var(--color-text-tertiary);
		}
	}
</style>
