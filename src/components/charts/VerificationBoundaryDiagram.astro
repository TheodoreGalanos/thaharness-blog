<!-- ABOUTME: Shows automated verification across an entire AI-enabled workflow. -->
<!-- ABOUTME: Reserves selective human permission for the boundary into consequential operation. -->
---
import { verificationBoundaryFigure } from '../../data/broad-creation-narrow-authority-figures';

const [createStage, iterateStage, permissionStage, operateStage] =
	verificationBoundaryFigure.stages;
const titleId = 'verification-boundary-title';
const descriptionId = 'verification-boundary-description';
---

<figure class="vbd" aria-labelledby={titleId} aria-describedby={descriptionId}>
	<header class="vbd-header">
		<span class="vbd-kicker">Control architecture</span>
		<span class="vbd-thesis">Continuous proof · selective permission</span>
	</header>

	<div class="vbd-title" id={titleId}>{verificationBoundaryFigure.title}</div>
	<p class="visually-hidden" id={descriptionId}>{verificationBoundaryFigure.description}</p>

	<div class="vbd-canvas" aria-hidden="true">
		<div class="vbd-human-row">
			<div class="vbd-human">
				<strong>Human permission</strong>
				<span>{verificationBoundaryFigure.humanJudgements.join(' · ')}</span>
			</div>
		</div>

		<div class="vbd-spine">
			<div class="vbd-stage">
				<span>01</span>
				<strong>{createStage.label}</strong>
			</div>
			<i class="vbd-arrow"></i>
			<div class="vbd-stage">
				<span>02</span>
				<strong>{iterateStage.label}</strong>
			</div>
			<i class="vbd-arrow"></i>
			<div class="vbd-gate" title={permissionStage.label}>
				<i></i>
				<span>Boundary</span>
			</div>
			<i class="vbd-arrow"></i>
			<div class="vbd-stage is-operate">
				<span>03</span>
				<strong>{operateStage.label}</strong>
			</div>
		</div>

		<div class="vbd-stems">
			<i></i>
			<i></i>
			<i></i>
			<i></i>
		</div>

		<div class="vbd-verification">
			<strong>Automated verification</strong>
			<span>Always on · every stage</span>
		</div>

		<ul class="vbd-checks">
			{verificationBoundaryFigure.verificationChecks.map((check) => <li>{check}</li>)}
		</ul>
	</div>

	<figcaption class="vbd-caption">{verificationBoundaryFigure.caption}</figcaption>
</figure>

<style>
	.vbd {
		--vbd-accent: var(--color-accent);
		--vbd-secondary: var(--color-accent-secondary);
		--vbd-line: color-mix(in srgb, var(--color-text-tertiary) 68%, transparent);
		--vbd-soft-line: color-mix(in srgb, var(--color-border) 82%, transparent);

		margin: 3.25rem 0 4rem;
		color: var(--color-text-primary);
		font-family: var(--font-body);
		text-align: left;
		container-type: inline-size;
	}

	.vbd-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.vbd-kicker,
	.vbd-thesis,
	.vbd-human,
	.vbd-stage span,
	.vbd-gate span,
	.vbd-verification,
	.vbd-checks,
	.vbd-caption {
		font-family: var(--font-mono);
	}

	.vbd-kicker {
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--vbd-accent);
	}

	.vbd-thesis {
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.vbd-title {
		margin: 0.9rem 0 1.35rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.vbd-canvas {
		padding: 1.2rem 1.1rem 1rem;
		border: 1px solid var(--vbd-soft-line);
		border-radius: 5px;
		background:
			linear-gradient(var(--color-bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-bg-grid) 1px, transparent 1px),
			color-mix(in srgb, var(--color-surface) 74%, transparent);
		background-size: 2rem 2rem;
	}

	.vbd-human-row,
	.vbd-spine {
		display: grid;
		grid-template-columns:
			minmax(0, 1fr) 1.35rem minmax(0, 1fr) 1.35rem 3.25rem 1.35rem
			minmax(0, 1fr);
	}

	.vbd-human {
		grid-column: 4 / 7;
		display: flex;
		align-items: center;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		padding-bottom: 0.8rem;
		text-align: center;
	}

	.vbd-human strong {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--vbd-accent);
	}

	.vbd-human span {
		font-size: 0.5625rem;
		line-height: 1.4;
		color: var(--color-text-tertiary);
	}

	.vbd-spine {
		align-items: center;
	}

	.vbd-stage {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.2rem;
		min-height: 4.2rem;
		border: 1px solid var(--vbd-soft-line);
		border-radius: 4px;
		background: color-mix(in srgb, var(--color-surface) 88%, transparent);
	}

	.vbd-stage span {
		font-size: 0.5rem;
		letter-spacing: 0.12em;
		color: var(--vbd-secondary);
	}

	.vbd-stage strong {
		font-family: var(--font-heading);
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--color-text-primary);
	}

	.vbd-stage.is-operate {
		border-color: color-mix(in srgb, var(--vbd-accent) 45%, var(--color-border));
	}

	.vbd-stage.is-operate span {
		color: var(--vbd-accent);
	}

	.vbd-arrow {
		position: relative;
		width: 100%;
		height: 1px;
		background: var(--vbd-line);
	}

	.vbd-arrow::after {
		content: '';
		position: absolute;
		top: 50%;
		right: -1px;
		width: 0;
		height: 0;
		border-top: 4px solid transparent;
		border-bottom: 4px solid transparent;
		border-left: 6px solid var(--vbd-line);
		transform: translateY(-50%);
	}

	.vbd-gate {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 0.55rem;
	}

	.vbd-gate i {
		width: 2.15rem;
		height: 2.15rem;
		border: 2px solid var(--vbd-accent);
		background: color-mix(in srgb, var(--vbd-accent) 10%, var(--color-bg));
		transform: rotate(45deg);
		box-shadow: 0 0 16px color-mix(in srgb, var(--vbd-accent) 18%, transparent);
	}

	.vbd-gate span {
		font-size: 0.5rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--vbd-accent);
	}

	.vbd-stems {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: 0.2rem;
	}

	.vbd-stems i {
		width: 1px;
		height: 2rem;
		justify-self: center;
		background: repeating-linear-gradient(
			to bottom,
			var(--vbd-line) 0 4px,
			transparent 4px 8px
		);
	}

	.vbd-verification {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		min-height: 3rem;
		border: 1px solid color-mix(in srgb, var(--vbd-secondary) 52%, var(--color-border));
		background:
			repeating-linear-gradient(
				135deg,
				color-mix(in srgb, var(--vbd-secondary) 14%, transparent) 0 4px,
				transparent 4px 9px
			),
			color-mix(in srgb, var(--vbd-secondary) 5%, var(--color-surface));
	}

	.vbd-verification strong {
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--vbd-secondary);
	}

	.vbd-verification span {
		font-size: 0.5625rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.vbd-checks {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.6rem;
		margin: 0;
		padding: 0.8rem 0 0;
		list-style: none;
		font-size: 0.5625rem;
		line-height: 1.4;
		text-align: center;
		color: var(--color-text-tertiary);
	}

	.vbd-checks li {
		position: relative;
		margin: 0;
		padding-top: 0.65rem;
	}

	.vbd-checks li::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 0.3rem;
		height: 0.3rem;
		border: 1px solid var(--vbd-secondary);
		transform: translateX(-50%) rotate(45deg);
	}

	.vbd-caption {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--color-text-tertiary);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@container (max-width: 34rem) {
		.vbd {
			margin: 2.5rem 0 3rem;
		}

		.vbd-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.45rem;
		}

		.vbd-title {
			margin-bottom: 1rem;
		}

		.vbd-canvas {
			padding: 0.9rem 0.55rem 0.8rem;
		}

		.vbd-human-row,
		.vbd-spine {
			grid-template-columns:
				minmax(0, 1fr) 0.65rem minmax(0, 1fr) 0.65rem 2.3rem 0.65rem
				minmax(0, 1fr);
		}

		.vbd-human {
			grid-column: 3 / 8;
			align-items: flex-end;
			text-align: right;
		}

		.vbd-human span {
			max-width: 12rem;
		}

		.vbd-stage {
			min-height: 3.6rem;
		}

		.vbd-stage strong {
			font-size: 0.6875rem;
		}

		.vbd-gate {
			gap: 0.45rem;
		}

		.vbd-gate i {
			width: 1.55rem;
			height: 1.55rem;
		}

		.vbd-gate span {
			font-size: 0.4375rem;
		}

		.vbd-verification {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.15rem;
			padding: 0.55rem 0.7rem;
		}

		.vbd-checks {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.8rem 0.4rem;
		}
	}
</style>
