<!-- ABOUTME: Three-column anatomy of a review task: documents in, review workflow, verifier gates out. -->
<!-- ABOUTME: Shows weighted gates and the eight hidden task versions that remain invisible to the agent. -->
---
import type { ReviewAnatomyData } from '../../data/fluent-but-unsafe-figures';

interface Props {
	title?: string;
	data: ReviewAnatomyData;
	caption?: string;
}

const { title, data, caption } = Astro.props;
---

<figure class="rta" aria-label={title ?? 'Anatomy of a review task'}>
	{title && <div class="rta-title">{title}</div>}

	<div class="rta-columns">
		<section class="rta-col" aria-label="Source documents">
			<div class="rta-kicker">the agent sees</div>
			<ul class="rta-docs">
				{data.documents.map((doc) => (
					<li>{doc}</li>
				))}
			</ul>
		</section>

		<section class="rta-col" aria-label="Review workflow">
			<div class="rta-kicker">the work</div>
			<ol class="rta-flow">
				{data.workflow.map((step, index) => (
					<li>
						<span class="rta-step-index">{String(index + 1).padStart(2, '0')}</span>
						{step}
					</li>
				))}
			</ol>
		</section>

		<section class="rta-col" aria-label="Grading checks">
			<div class="rta-kicker">the grader checks</div>
			<div class="rta-gates">
				{data.gates.map((gate) => (
					<div class="rta-gate">
						<div class="rta-gate-head">
							<strong>{gate.label}</strong>
							<span class="rta-weight">{gate.weight}</span>
						</div>
						<span class="rta-gate-note">{gate.note}</span>
					</div>
				))}
			</div>
		</section>
	</div>

	<section class="rta-variants" aria-label="Hidden task versions">
		<div class="rta-variant-head">
			<div>
				<div class="rta-kicker">hidden from the agent</div>
				<strong>each task uses one hidden version</strong>
			</div>
			<span>{data.variantNote}</span>
		</div>

		<ul class="rta-variant-strip">
			{data.variants.map((variant) => (
				<li class:list={[variant.kind === 'clean' && 'rta-variant-clean']}>
					<span>{variant.label}</span>
				</li>
			))}
		</ul>
	</section>

	{caption && <figcaption class="rta-caption">{caption}</figcaption>}
</figure>

<style>
	.rta {
		margin: 3rem 0;
		font-family: var(--font-body);
		color: var(--color-text-primary);
		container-type: inline-size;
	}

	.rta-title {
		margin: 0 0 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.rta-columns {
		display: grid;
		grid-template-columns: 1fr 0.9fr 1.2fr;
		gap: 1rem;
	}

	@container (max-width: 700px) {
		.rta-columns {
			grid-template-columns: 1fr;
		}
	}

	.rta-col {
		padding: 1.125rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: color-mix(in srgb, var(--color-surface) 90%, transparent);
	}

	.rta-kicker {
		margin-bottom: 0.875rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.rta-docs,
	.rta-flow {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.rta-docs li {
		padding: 0.5rem 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-bg);
		font-size: 0.8125rem;
	}

	.rta-flow li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.8125rem;
	}

	.rta-step-index {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-accent);
	}

	.rta-gates {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.rta-gate {
		padding: 0.5rem 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		background: var(--color-bg);
	}

	.rta-gate-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
	}

	.rta-gate-head strong {
		font-size: 0.8125rem;
	}

	.rta-weight {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-accent);
	}

	.rta-gate-note {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.75rem;
		line-height: 1.45;
		color: var(--color-text-secondary);
	}

	.rta-variants {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.rta-variant-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.rta-variant-head .rta-kicker {
		margin-bottom: 0.2rem;
	}

	.rta-variant-head strong {
		font-size: 0.875rem;
		font-weight: 500;
	}

	.rta-variant-head > span {
		max-width: 25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.45;
		text-align: right;
		color: var(--color-text-tertiary);
	}

	.rta-variant-strip {
		display: grid;
		grid-template-columns: repeat(8, minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		padding: 1px;
		overflow: hidden;
		border-radius: 6px;
		background: var(--color-border);
		list-style: none;
	}

	.rta-variant-strip li {
		display: flex;
		min-width: 0;
		min-height: 4rem;
		padding: 0.55rem 0.5rem;
		flex-direction: column;
		gap: 0.3rem;
		background: var(--color-bg);
		font-size: 0.8125rem;
		line-height: 1.25;
		color: var(--color-text-primary);
	}

	.rta-variant-strip li::before {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--color-accent);
		content: '';
	}

	.rta-variant-strip .rta-variant-clean::before {
		background: var(--color-accent-secondary);
	}

	.rta-caption {
		margin-top: 1rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--color-text-tertiary);
	}

	@container (max-width: 820px) {
		.rta-variant-strip {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@container (max-width: 430px) {
		.rta-variant-head {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.35rem;
		}

		.rta-variant-head > span {
			max-width: none;
			text-align: left;
		}

		.rta-variant-strip {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
