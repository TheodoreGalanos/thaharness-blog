<!-- ABOUTME: Changes the resolved page theme and remembers an explicit choice. -->
<!-- ABOUTME: Works even when browser storage is unavailable. -->
<button id="theme-toggle" type="button" aria-label="Change colour theme" class="theme-toggle">
	<svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"
		><circle cx="12" cy="12" r="4"></circle><path
			d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path></svg
	>
	<svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"
		><path d="M20 15.5A9 9 0 0 1 8.5 4 9 9 0 1 0 20 15.5Z"></path></svg
	>
</button>
<script>
	const button = document.getElementById('theme-toggle');
	const updateLabel = () =>
		button?.setAttribute(
			'aria-label',
			document.documentElement.dataset.theme === 'dark'
				? 'Switch to light mode'
				: 'Switch to dark mode',
		);
	updateLabel();
	button?.addEventListener('click', () => {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch (_) {
			/* The current page can still change theme. */
		}
		updateLabel();
	});
</script>
<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		flex: none;
		color: var(--color-text-secondary);
		cursor: pointer;
	}
	svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.theme-moon {
		display: none;
	}
	:global([data-theme='light']) .theme-sun {
		display: none;
	}
	:global([data-theme='light']) .theme-moon {
		display: block;
	}
</style>
