<!-- ABOUTME: Dark-mode editorial blog post layout inspired by Anthropic's long-form features. -->
<!-- ABOUTME: Warm-dark surface, Fraunces headlines, and stable chapter navigation. -->
---
import { Image } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { CollectionEntry } from 'astro:content';
import '../styles/chart-hover-panel.css';
import '../styles/editorial.css';
import BaseHead from '../components/BaseHead.astro';
import ChapterStrip from '../components/ChapterStrip.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagPill from '../components/TagPill.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { articleWordCount } from '../lib/article-html';

type RelatedPost = CollectionEntry<'blog'>;

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type PostData = CollectionEntry<'blog'>['data'];

interface Props extends PostData {
	slug: string;
	relatedPosts: RelatedPost[];
	headings: Heading[];
}

const {
	title,
	seoTitle,
	description,
	pubDate,
	updatedDate,
	author,
	heroImage,
	tags,
	category,
	slug,
	relatedPosts,
	headings = [],
} = Astro.props;
const articleHtml = await Astro.slots.render('default');
const wordCount = articleWordCount(articleHtml);
const readingTime = Math.max(1, Math.ceil(wordCount / 180));
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead
			title={title}
			seoTitle={seoTitle}
			description={description}
			image={heroImage ?? `/og/${slug}.png`}
			type="article"
			author={author}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={tags}
			wordCount={wordCount}
			articleSection={category}
		/>
	</head>

	<body class="editorial-layout" style="background-color: var(--color-bg);">
		<div class="editorial-progress" aria-hidden="true">
			<div class="editorial-progress-bar"></div>
		</div>
		<Header />
		<main id="main-content">
			<article class="editorial-article">
				<header class="editorial-header">
					<span class="editorial-kicker">
						{category ? `${category} · ` : ''}{readingTime} min read
					</span>
					<h1 class="editorial-headline">{title}</h1>
					{description && <p class="editorial-deck">{description}</p>}
					<div class="editorial-meta">
						<a href="/about/">By {author}</a>
						<span class="editorial-meta-sep">·</span>
						<FormattedDate date={pubDate} />
						{
							updatedDate && updatedDate.valueOf() !== pubDate.valueOf() && (
								<>
									<span class="editorial-meta-sep">·</span>
									<span>Updated {updatedDate.toISOString().split('T')[0]}</span>
								</>
							)
						}
					</div>
					{
						tags.length > 0 && (
							<div class="editorial-tags">
								{tags.slice(0, 2).map((tag: string) => (
									<TagPill tag={tag} />
								))}
								{tags.length > 2 && (
									<details class="more-tags">
										<summary>All topics ({tags.length})</summary>
										<div>
											{tags.slice(2).map((tag) => (
												<TagPill tag={tag} />
											))}
										</div>
									</details>
								)}
							</div>
						)
					}
				</header>

				<ChapterStrip headings={headings} />

				{
					heroImage && (
						<div class="editorial-hero">
							<Image width={1040} height={585} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="editorial-body">
					<div class="prose post-content" data-pagefind-body>
						<Fragment set:html={articleHtml} />
					</div>
				</div>
			</article>
			<aside class="article-follow page-shell" aria-label="Continue reading">
				{
					relatedPosts.length > 0 && (
						<section class="related-posts">
							<>
								<h2>Continue reading</h2>
								<ul>
									{relatedPosts.map((post) => (
										<li>
											<a href={`/blog/${post.id}/`}>
												<h3>{post.data.title}</h3>
												<p>{post.data.description}</p>
											</a>
										</li>
									))}
								</ul>
							</>
						</section>
					)
				}
				<SubscribeForm
					variant="inline"
					title="Follow the work"
					description="Get new essays on reliable AI agents and real engineering work when they publish."
					inputId="article-subscribe-email"
				/>
			</aside>
		</main>
		<Footer />
		<Analytics />
		<SpeedInsights />
		<script src="../scripts/editorial.ts"></script>
		<script src="../scripts/image-lightbox.ts"></script>

		<style>
			.editorial-progress {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				height: 2px;
				z-index: 100;
				pointer-events: none;
			}

			.editorial-progress-bar {
				height: 100%;
				width: 100%;
				background-color: var(--color-accent);
				transform: scaleX(0);
				transform-origin: left center;
				will-change: transform;
			}

			.editorial-article {
				max-width: 1180px;
				margin: 0 auto;
				padding: 0 1.25rem;
			}

			.editorial-header {
				max-width: 42rem;
				margin: 0 auto;
				padding: 2rem 0 1.5rem;
			}

			@media (min-width: 768px) {
				.editorial-header {
					padding: 3.5rem 0 2rem;
				}
			}

			.editorial-kicker {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.6875rem;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--color-accent);
				margin-bottom: 1.25rem;
			}

			.editorial-headline {
				font-family: var(--font-display);
				font-weight: 500;
				font-size: clamp(2.25rem, 5vw, 3.75rem);
				letter-spacing: -0.015em;
				line-height: 1.08;
				color: var(--color-text-primary);
				margin: 0;
			}

			.editorial-deck {
				font-family: var(--font-body);
				font-size: 1.25rem;
				line-height: 1.5;
				color: var(--color-text-secondary);
				margin: 1.25rem 0 0;
				max-width: 36rem;
			}

			.editorial-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-tertiary);
				margin-top: 1.75rem;
			}

			.editorial-meta-sep {
				color: var(--color-text-tertiary);
			}

			.editorial-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 1rem;
			}

			.editorial-hero {
				max-width: 1040px;
				margin: 0 auto 3rem;
			}

			.editorial-hero img {
				width: 100%;
				height: auto;
				border-radius: 4px;
				border: none;
				background: transparent;
				padding: 0;
			}

			.editorial-body {
				max-width: 60rem;
				margin: 0 auto;
				padding-bottom: 5rem;
			}
			.editorial-meta a {
				color: var(--color-text-secondary);
			}
			.more-tags {
				font-family: var(--font-mono);
				font-size: 0.75rem;
			}
			.more-tags summary {
				min-height: 44px;
				display: flex;
				align-items: center;
				cursor: pointer;
				color: var(--color-text-secondary);
			}
			.more-tags div {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				padding-top: 0.5rem;
			}
			.article-follow {
				max-width: 64rem;
			}
			.related-posts {
				border-top: 1px solid var(--color-border);
				padding-top: 2rem;
				margin-bottom: 3rem;
			}
			.related-posts h2 {
				font-family: var(--font-display);
				font-size: 1.75rem;
			}
			.related-posts ul {
				list-style: none;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 2rem;
			}
			.related-posts a {
				display: block;
				color: var(--color-text-primary);
			}
			.related-posts h3 {
				font-family: var(--font-display);
				font-size: 1.375rem;
			}
			.related-posts p {
				color: var(--color-text-secondary);
				font-size: 1rem;
				margin: 0.75rem 0 0;
			}
			@media (max-width: 768px) {
				.related-posts ul {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.editorial-deck {
					font-size: 1.125rem;
				}
			}
		</style>
	</body>
</html>
